# Copy to .env for local development: `cp .env.example .env`
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=debug

# Postgres (docker compose up db)
DATABASE_URL=postgres://learnly:learnly@localhost:5432/learnly
DATABASE_POOL_MAX=10

# Auth — generate a real secret with: openssl rand -base64 48
JWT_SECRET=dev-only-secret-change-me-please-0123456789
JWT_ISSUER=learnly-api
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://localhost:8081
# Number of proxy hops in front of the API (load balancer = 1)
TRUST_PROXY=0
RATE_LIMIT_PER_MINUTE=240
AUTH_RATE_LIMIT_PER_MINUTE=10


# Adaptive engine: v2 = BKT mastery + spaced repetition, v1 = Rasch only
ENGINE_VERSION=v2
# Nightly BKT fit + difficulty calibration (UTC hour)
JOBS_ENABLED=true
NIGHTLY_JOBS_HOUR_UTC=3
# Optional bearer token required to scrape /metrics
METRICS_TOKEN=
SHUTDOWN_TIMEOUT_MS=15000
