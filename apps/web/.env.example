# Copy to .env.local and adjust.

# Origin of the Learnly API. Leave empty to use the Vite dev proxy (/v1 → LEARNLY_API_ORIGIN).
VITE_API_URL=

# Run entirely in the browser against the MSW mock API (same as `npm run dev:mock`).
VITE_USE_MOCKS=false

# Used by vite.config.ts for the dev-server proxy.
LEARNLY_API_ORIGIN=http://localhost:4000
